<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maradrone_utils</name>
  <version>0.1.0</version>
  <description>Shared header-only utilities (attitude conversions, quintic trajectory generation) reused by maradrone_framework, offboard_rl, read_rpy and maradrone_mission.</description>
  <maintainer email="g.vestri2904@gmail.com">Giulio Vestri</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen3_cmake_module</depend>
  <depend>Eigen3</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
