<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maradrone_slam</name>
  <version>0.1.0</version>
  <description>Launch-only package: bridges the x500_depth RGB-D camera into ROS 2 and runs RTAB-Map RGB-D SLAM on top of it.</description>
  <maintainer email="g.vestri2904@gmail.com">Giulio Vestri</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rtabmap_launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
